{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWAG unreviewed routing observation",
  "description": "One JSON object per line. Local observations are not engine receipts or verified training labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured_at", "label_status", "training_consent", "route", "record_id", "project_id", "task_id", "source_type", "task_type", "stack", "domain", "issue_title", "issue_id", "repo_context", "intent_text", "selected_question_ids", "route_target_tier", "user_override", "user_acceptance", "confidence", "rationale", "outcome", "source_provenance"],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "unknownBoolean": {"type": ["boolean", "null"]},
    "strings": {"type": "array", "items": {"type": "string"}},
    "nativeRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_manifest_sha256", "runtime_cursor", "catalogue_revision"],
      "properties": {
        "runtime_manifest_sha256": {"$ref": "#/$defs/digest"},
        "runtime_cursor": {"type": "integer", "minimum": 0},
        "schema_revision": {"type": "integer", "minimum": 0},
        "catalogue_revision": {"type": "integer", "minimum": 0}
      }
    },
    "nativeAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_sha256",
        "configuration_sha256",
        "packet_sha256",
        "request_sha256",
        "response_sha256",
        "content_sha256",
        "outcome_sha256",
        "attempt_id",
        "binding_id",
        "service_id",
        "ordinal",
        "status",
        "usage",
        "elapsed_ms",
        "http_status"
      ],
      "properties": {
        "task_sha256": {"$ref": "#/$defs/digest"},
        "configuration_sha256": {"$ref": "#/$defs/digest"},
        "packet_sha256": {"$ref": "#/$defs/digest"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "response_sha256": {"$ref": "#/$defs/digest"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "outcome_sha256": {"$ref": "#/$defs/digest"},
        "attempt_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "binding_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "service_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "ordinal": {"type": "integer", "minimum": 1},
        "status": {"const": "accepted"},
        "usage": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
              "properties": {
                "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
                "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
                "total_tokens": {"type": ["integer", "null"], "minimum": 0}
              }
            },
            {"type": "null"}
          ]
        },
        "elapsed_ms": {"type": ["integer", "null"], "minimum": 0},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}
      }
    },
    "nativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "captured_snapshot_sha256",
        "entry_identity",
        "path_sha256",
        "content_sha256",
        "policy_sha256",
        "profile_sha256",
        "validated_snapshot_sha256",
        "project_id",
        "captured_read",
        "validated_read",
        "captured_at_unix_ms",
        "validated_at_unix_ms"
      ],
      "properties": {
        "contract_version": {"const": 1},
        "captured_snapshot_sha256": {"$ref": "#/$defs/digest"},
        "entry_identity": {"$ref": "#/$defs/digest"},
        "path_sha256": {"$ref": "#/$defs/digest"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "policy_sha256": {"$ref": "#/$defs/digest"},
        "profile_sha256": {"$ref": "#/$defs/digest"},
        "validated_snapshot_sha256": {"$ref": "#/$defs/digest"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "captured_read": {"$ref": "#/$defs/nativeRead"},
        "validated_read": {"$ref": "#/$defs/nativeRead"},
        "captured_at_unix_ms": {"type": "integer", "minimum": 0},
        "validated_at_unix_ms": {"type": "integer", "minimum": 0}
      }
    },
    "nativeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "relationship", "reviewed_at"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "relationship": {"const": "prior_observation_only_not_capture_review"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "nativeDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "event_id",
        "source_response_sha256",
        "payload_sha256",
        "configuration_sha256",
        "receiver_source_sha256",
        "observation"
      ],
      "properties": {
        "delivery_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "event_id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_response_sha256": {"$ref": "#/$defs/digest"},
        "payload_sha256": {"$ref": "#/$defs/digest"},
        "configuration_sha256": {"$ref": "#/$defs/digest"},
        "receiver_source_sha256": {"type": "null"},
        "observation": {"const": "matching_event_in_retained_receiver_readback"}
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["native_attempt"]},
      "then": {
        "properties": {
          "source_provenance": {"properties": {"source_type": {"const": "retained_native_attempt"}}},
          "selected_question_ids": {"maxItems": 0},
          "intent_text": {"const": ""},
          "issue_title": {"const": ""}
        },
        "not": {"required": ["source_snapshot"]}
      }
    },
    {
      "if": {"properties": {"source_provenance": {"properties": {"source_type": {"const": "retained_native_attempt"}}}}},
      "then": {"required": ["native_attempt"]}
    }
  ],
  "properties": {
    "native_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "identity",
        "identity_sha256",
        "digest_semantics",
        "task_goal_sha256",
        "selector",
        "worker",
        "selected_effort",
        "model_revision",
        "loaded_weights_attestation",
        "source",
        "source_bytes",
        "worker_read",
        "evidence_sha256",
        "prior_review",
        "delivery"
      ],
      "properties": {
        "contract_version": {"const": 1},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance_id", "scope", "task_id", "attempt_id"],
          "properties": {
            "instance_id": {"type": "string", "minLength": 1, "maxLength": 4096},
            "scope": {"type": "string", "minLength": 1, "maxLength": 4096},
            "task_id": {"type": "string", "minLength": 1, "maxLength": 4096},
            "attempt_id": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        "identity_sha256": {"$ref": "#/$defs/digest"},
        "digest_semantics": {"const": "engine_reported_typed_digests_with_verified_artifact_and_content_bytes"},
        "task_goal_sha256": {"$ref": "#/$defs/digest"},
        "selector": {"$ref": "#/$defs/nativeAttempt"},
        "worker": {"$ref": "#/$defs/nativeAttempt"},
        "selected_effort": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 4096}, {"type": "null"}]},
        "model_revision": {"type": "null"},
        "loaded_weights_attestation": {"type": "null"},
        "source": {"$ref": "#/$defs/nativeSource"},
        "source_bytes": {"type": "integer", "minimum": 0},
        "worker_read": {"$ref": "#/$defs/nativeRead"},
        "evidence_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "worker", "selector", "source", "budget"],
          "properties": {
            "task": {"$ref": "#/$defs/digest"},
            "worker": {"$ref": "#/$defs/digest"},
            "selector": {"$ref": "#/$defs/digest"},
            "source": {"$ref": "#/$defs/digest"},
            "budget": {"$ref": "#/$defs/digest"},
            "prior_review": {"$ref": "#/$defs/digest"},
            "prepared_delivery": {"$ref": "#/$defs/digest"},
            "receiver_readback": {"$ref": "#/$defs/digest"}
          },
          "dependentRequired": {"prepared_delivery": ["receiver_readback"], "receiver_readback": ["prepared_delivery"]}
        },
        "prior_review": {"anyOf": [{"$ref": "#/$defs/nativeReview"}, {"type": "null"}]},
        "delivery": {"anyOf": [{"$ref": "#/$defs/nativeDelivery"}, {"type": "null"}]}
      }
    },
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "head", "branch", "branch_sha256", "status_sha256", "staged_diff_sha256", "unstaged_diff_sha256", "context_sha256", "stream_id", "snapshot_sha256", "previous_record_id"],
      "properties": {
        "scope": {"const": "tracked_files_only"},
        "head": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "branch": {"type": "string", "maxLength": 4096},
        "branch_sha256": {"$ref": "#/$defs/digest"},
        "status_sha256": {"$ref": "#/$defs/digest"},
        "staged_diff_sha256": {"$ref": "#/$defs/digest"},
        "unstaged_diff_sha256": {"$ref": "#/$defs/digest"},
        "context_sha256": {"$ref": "#/$defs/digest"},
        "stream_id": {"$ref": "#/$defs/digest"},
        "snapshot_sha256": {"$ref": "#/$defs/digest"},
        "previous_record_id": {"type": ["string", "null"], "pattern": "^passive-[0-9a-f]{12}$"}
      }
    },
    "schema_version": {"const": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "label_status": {"const": "unreviewed"},
    "training_consent": {"const": false},
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "modelId", "effort", "accessMode", "bindingId"],
      "properties": {
        "provider": {"$ref": "#/$defs/nullableString"},
        "modelId": {"$ref": "#/$defs/nullableString"},
        "effort": {"$ref": "#/$defs/nullableString"},
        "accessMode": {"enum": ["subscription", "api", "local", null]},
        "bindingId": {"$ref": "#/$defs/nullableString"}
      }
    },
    "record_id": {"type": "string", "pattern": "^passive-[0-9a-f]{12}$"},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^task-[0-9a-f]{12}$"},
    "source_type": {"const": "passive_capture"},
    "task_type": {"type": "string"},
    "stack": {"$ref": "#/$defs/strings"},
    "domain": {"type": "string"},
    "issue_title": {"type": "string"},
    "issue_id": {"type": "string"},
    "repo_context": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "repo_root", "changed_files"],
      "properties": {"branch": {"type": "string"}, "repo_root": {"type": "string"}, "changed_files": {"anyOf": [{"$ref": "#/$defs/strings"}, {"type": "null"}]}}
    },
    "intent_text": {"type": "string"},
    "selected_question_ids": {"$ref": "#/$defs/strings"},
    "route_target_tier": {"$ref": "#/$defs/nullableString"},
    "user_override": {"$ref": "#/$defs/unknownBoolean"},
    "user_acceptance": {"$ref": "#/$defs/unknownBoolean"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "rationale": {"type": "string"},
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["tests_passed", "rollback", "incident"],
      "properties": {"tests_passed": {"$ref": "#/$defs/unknownBoolean"}, "rollback": {"$ref": "#/$defs/unknownBoolean"}, "incident": {"$ref": "#/$defs/unknownBoolean"}}
    },
    "source_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "source_url", "reviewer", "notes"],
      "properties": {"source_type": {"enum": ["explicit_input_and_git_status", "bounded_local_git_and_task_watch", "retained_native_attempt"]}, "source_url": {"type": "string"}, "reviewer": {"type": "string"}, "notes": {"type": "string"}}
    }
  }
}
