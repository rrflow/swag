{
  "schemaVersion": 1,
  "name": "swag-connectome-panel",
  "readOnlyDefault": true,
  "panels": [
    {
      "id": "projects-overview",
      "title": "Projects",
      "kind": "summary",
      "source": "swag/project-status",
      "requires": ["projectId"]
    },
    {
      "id": "route-approval",
      "title": "Route proposals",
      "kind": "routes",
      "source": "swag/semantic-router",
      "requires": ["projectId", "taskId"]
    },
    {
      "id": "evidence-stream",
      "title": "Evidence",
      "kind": "evidence",
      "source": "rrflow/evidence",
      "requires": ["projectId"]
    },
    {
      "id": "policy-gate",
      "title": "Policy gate",
      "kind": "status",
      "source": "rrflow/policy",
      "requires": ["projectId"]
    }
  ],
  "actions": [
    {
      "name": "approve_route",
      "requires": ["projectId", "taskId", "routeId"],
      "authoritative": true,
      "target": "rrflow/route-approve"
    },
    {
      "name": "reject_route",
      "requires": ["projectId", "taskId", "routeId"],
      "authoritative": true,
      "target": "rrflow/route-reject"
    }
  ]
}
