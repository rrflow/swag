# SWAG decision server (tools/swag_server.py)
SWAG_HOST=127.0.0.1
SWAG_PORT=8792
# Required when SWAG_HOST is not a loopback address, so other machines cannot use your model.
# SWAG_SERVER_TOKEN=
# The model SWAG asks; see docs/decision-contract.md. Without it only hard rules decide.
# SWAG_DECISION_MODEL_CONNECTION_FILE=
