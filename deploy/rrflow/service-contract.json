{
  "schemaVersion": 1,
  "name": "rrflow-public-contract",
  "authority": "engine",
  "readOnlyEndpoints": [
    "/health",
    "/v1/status",
    "/v1/diagnostics",
    "/v1/policy/status"
  ],
  "mutableEndpoints": [
    "/v1/route/approve",
    "/v1/route/reject",
    "/v1/evidence/record",
    "/v1/session/create",
    "/v1/session/close"
  ],
  "requiredAuth": {
    "mode": "api_key",
    "claims": ["session", "routeApproval", "evidenceWrite"]
  },
  "connectomeCompatibility": {
    "readOnlyDefault": true,
    "panelContract": "deploy/connectome/panel-contract.json"
  }
}
